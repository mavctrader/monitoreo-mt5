# Plantilla del .env del agente. Copiar como .env y completar.
# El .env real NO va al repositorio (está en .gitignore).
#
# La key de abajo es la publicable, la misma que lleva el panel dentro del
# navegador: es pública por diseño y sin iniciar sesión no da acceso a nada,
# porque todas las políticas RLS exigen un usuario concreto. No usar nunca
# acá la key service_role.
SUPABASE_URL=https://wjmupiiwwwngigqyggex.supabase.co
SUPABASE_ANON_KEY=sb_publishable_YZQ9ZA7GMFJJrceE4uLVIw_-4xFmXZG

# Usuario dedicado del agente, el de permisos recortados. El email y la
# contraseña van solo en el .env de la VPS, nunca acá: el repositorio es
# público y dejar el email escrito le regala media credencial a cualquiera.
AGENTE_EMAIL=
AGENTE_PASSWORD=

# Opcional: ruta de la carpeta Common si no es la que Windows arma por
# defecto. Se arma sola con %APPDATA% si se deja vacía.
# COMMON_PATH=C:\Users\...\AppData\Roaming\MetaQuotes\Terminal\Common\Files\MonitoreoMT5
